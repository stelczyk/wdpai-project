# Skopiuj do .env i uzupełnij własnymi wartościami. Pliku .env nie commituj.

# PostgreSQL – używane przez kontener bazy i przez aplikację (klasa App\Database)
POSTGRES_DB=dystans
POSTGRES_USER=dystans
POSTGRES_PASSWORD=change-me

# Adres bazy widziany z kontenera php (nazwa serwisu z docker-compose.yaml)
DB_HOST=db
DB_PORT=5432

# pgAdmin – http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# Publiczny adres aplikacji – używany w linkach wysyłanych mailem
APP_URL=http://localhost:8080

# Poczta (PHPMailer). Lokalnie Mailpit bez logowania – podgląd maili: http://localhost:8025
# Na produkcji: dane prawdziwego serwera SMTP (+ SMTP_USER / SMTP_PASSWORD).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@dystans.app
MAIL_FROM_NAME=Dystans
